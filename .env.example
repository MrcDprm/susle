# Neon Postgres bağlantı adresi. Boş bırakılırsa yerelde .pglite klasöründe gömülü bir veritabanı açılır.
DATABASE_URL=

# Cloudflare Turnstile. Aşağıdakiler Cloudflare'in her zaman geçen test anahtarlarıdır, yalnızca yerelde kullan.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# IP adresleri bu tuzla özetlenir, düz metin saklanmaz. En az 32 rastgele karakter.
IP_HASH_SALT=

# Sitenin kendi adresi; paylaşım linkleri ve önizleme görselleri bununla kurulur.
NEXT_PUBLIC_SITE_URL=http://localhost:3300
